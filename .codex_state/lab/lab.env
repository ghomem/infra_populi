# Lab settings read by the engine's tools (tracked; HQ step review C of escalations/lab-network-static.md, 2026-11-10).
# NODE_NET  bridged  = revert_node.sh reaches the restored node over its bridged (Wi-Fi) address, v2 as is
#           hostonly = revert_node.sh applies the host-only overlay after every v2 restore (canary period: set in step 6,
#                      removed together with the overlay in step 9)
NODE_NET=bridged
