#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# TRACKED TOOLING. This script is version-controlled because it consumes
# tracked structured data: codex_migrate_class calls
# 'gen_migration_order.py --classify', which parses migration_plan.md.
# Tracking the generator and the plan but not their consumer would leave the
# interface unversioned on one side. See DESIGN_DECISIONS.md.
#
# NOT host-portable as-is. Host-specific assumptions:
#   repo path    /home/salatiel/work/infra_populi
#   SSH aliases  puppet8master, puppet8master-rsync, puppet8node
#   master paths /etc/puppetlabs/code/environments/production/...
#   params dir   ~/.config/infra_populi/params  (UNTRACKED: environment-specific
#                values, deliberately not versioned - see the tooling-tracking
#                decision in DESIGN_DECISIONS.md)
# Parameterizing these via environment variables is a known future improvement.
# ---------------------------------------------------------------------------

set -euo pipefail
exec </dev/null

[[ $# -ge 1 ]] || { echo "Usage: codex_migrate_class <puppet_class_name>"; exit 2; }
CLASS="$1"

REPO="$(git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)"
cd "$REPO"
# Single sources (step 3.5): the tracked runbook, then the tracked hazard checklist.
RUNBOOK=".codex_state/rules/CODEX_RUNBOOK.md"
HAZARDS=".codex_state/rules/hazards.md"
for f in "$RUNBOOK" "$HAZARDS"; do [[ -f "$f" ]] || { echo "Missing $f"; exit 2; }; done
SHORT="${CLASS#puppet_infrastructure::}"
# The CLASS's baseline: the pin, or its per-class exception (.codex_state/rules/baseline_exceptions.txt).
BASELINE_LABEL="$(python3 .codex_state/tools/baseline.py for "$SHORT")"
BASELINE="${BASELINE_LABEL%% *}"
# Outer timeout (ruling 2 / step 1.1). Longest observed run: 985 s; a hang was 47 min.
CODEX_TIMEOUT_SECONDS="${CODEX_TIMEOUT_SECONDS:-1800}"

METRICS=(python3 .codex_state/tools/metrics.py)

# Revert first (step 1.2): Codex's first harness run must start from the clean baseline.
revert_out="$(.codex_state/tools/revert_node.sh)" || { echo "$revert_out"; echo "REVERT_FAILED: node not restored; Codex not started" >&2; exit 3; }
echo "$revert_out"
# Step 3.4: per-attempt metrics events (untracked until `metrics.py close`).
revert_json="$(sed -n 's/^REVERT_METRICS //p' <<<"$revert_out" | tail -1)"
[[ -z "$revert_json" ]] || "${METRICS[@]}" event "$CLASS" revert "$revert_json" || true

# Orientation packet (step 3.2): facts gathered now, so Codex does not rediscover them.
PACKET="$(python3 .codex_state/tools/orientation.py "$CLASS" 2>&1)" || PACKET="ORIENTATION PACKET unavailable: ${PACKET}"

rc=0
codex_start="${EPOCHREALTIME}"
start_head="$(git rev-parse HEAD)"
# content of every file already dirty before the run, so the audit reports only what the run changed
pre_dirty="$(git status --porcelain --untracked-files=all | cut -c4- | while IFS= read -r f; do
  printf '%s\t%s\n' "$f" "$(git hash-object -- "$f" 2>/dev/null || echo gone)"; done)"
# HQ 2026-11-11 ruling 2: the run marker — the pre-commit hook refuses advisor-only files under it.
export CODEX_RUN=1
timeout --kill-after=30 "$CODEX_TIMEOUT_SECONDS" codex exec \
  -c 'sandbox_mode="danger-full-access"' \
  -c 'approval_policy="never"' \
  "$(cat "$RUNBOOK")

$(cat "$HAZARDS")

TARGET CLASS: $CLASS

$PACKET

The wrapper has just reverted the node to its baseline. First action: run the harness (line above).
Baseline for this class: ${BASELINE_LABEL}. Read baseline content ONLY with: python3 .codex_state/tools/baseline.py show --for $SHORT <path>.
Record with .codex_state/tools/record_green.sh $CLASS (runbook section 2). A deliberate divergence from ${BASELINE}: stop and report.
" || rc=$?
if [[ $rc -eq 124 || $rc -eq 137 ]]; then
  echo "CODEX_TIMEOUT: codex exec killed after ${CODEX_TIMEOUT_SECONDS}s" >&2
fi
codex_s="$(python3 -c 'import sys; print(round(float(sys.argv[2]) - float(sys.argv[1]), 1))' "${codex_start/,/.}" "${EPOCHREALTIME/,/.}")"
usage="$("${METRICS[@]}" codex-usage "${codex_start/,/.}" 2>/dev/null || echo '{}')"
# Post-run authority audit (catches `git commit --no-verify` and uncommitted edits too).
unset CODEX_RUN
violations="$(P8_PRE_DIRTY="$pre_dirty" python3 - "$start_head" <<'PY'
import fnmatch, os, subprocess, sys
pats = [l.strip() for l in open(".codex_state/rules/advisor_only.txt") if l.strip() and not l.lstrip().startswith("#")]
def bad(path):
    return any(fnmatch.fnmatchcase(path, p) for p in pats)
out = []
log = subprocess.run(["git", "log", "--format=%h", f"{sys.argv[1]}..HEAD"], capture_output=True, text=True).stdout.split()
for c in log:
    files = subprocess.run(["git", "show", "--name-only", "--format=", c], capture_output=True, text=True).stdout.split()
    hit = [f for f in files if bad(f)]
    if hit:
        out.append(f"commit {c}: {' '.join(hit)}")
before = dict(l.split("\t", 1) for l in os.environ.get("P8_PRE_DIRTY", "").splitlines() if "\t" in l)
def blob(path):
    r = subprocess.run(["git", "hash-object", "--", path], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else "gone"
dirty = [l[3:] for l in subprocess.run(["git", "status", "--porcelain", "--untracked-files=all"],
                                        capture_output=True, text=True).stdout.splitlines()]
hit = [f for f in dirty if bad(f) and before.get(f) != blob(f)]
if hit:
    out.append(f"uncommitted: {' '.join(hit)}")
print("\n".join(out))
PY
)"
if [[ -n "$violations" ]]; then
  echo "AUTHORITY_VIOLATION: Codex changed advisor-only files (.codex_state/rules/advisor_only.txt):" >&2
  echo "$violations" >&2
  [[ $rc -ne 0 ]] || rc=5
fi
"${METRICS[@]}" event "$CLASS" codex "{\"rc\": ${rc}, \"codex_s\": ${codex_s}, \"timeout\": $([[ $rc -eq 124 || $rc -eq 137 ]] && echo true || echo false), \"usage\": ${usage}}" || true
exit "$rc"
