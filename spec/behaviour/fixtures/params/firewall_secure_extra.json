{
  "acl": [
    "{{CONTROLLER_ADDR}}"
  ],
  "anti_ddos": true,
  "service_list": [
    [
      "8888",
      "tcp"
    ]
  ],
  "ddos_limit": "3",
  "ddos_limit_per_time_unit": "2",
  "ddos_limit_time_unit": "sec",
  "ip_filter": true,
  "ip_whitelist": [
    "{{PEER_ADDR+100}}"
  ],
  "ip_blacklist": [
    "{{PEER_ADDR+150}}"
  ]
}
