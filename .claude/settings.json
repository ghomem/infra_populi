{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(codex_migrate_class *)",
      "Bash(~/.local/bin/codex_migrate_class *)",
      "Bash(codex exec *)",
      "Bash(git *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(VBoxManage *)",
      "Bash(.codex_state/tools/*)",
      "Bash(python3 .codex_state/*)",
      "Bash(~/.local/bin/infra_populi_tools/*)",
      "Bash(cat *)", "Bash(ls *)", "Bash(grep *)", "Bash(head *)", "Bash(tail *)",
      "Bash(wc *)", "Bash(diff *)", "Bash(date *)", "Bash(mkdir *)", "Bash(tee *)",
      "Bash(timeout *)", "Bash(sleep *)",
      "WebSearch", "WebFetch"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(ssh puppet.mdops.es*)",
      "Bash(ssh salatiel@puppet.mdops.es*)",
      "Bash(VBoxManage snapshot Ubuntu24-puppet8-Master *)",
      "Bash(VBoxManage controlvm Ubuntu24-puppet8-Master poweroff*)",
      "Bash(VBoxManage controlvm Ubuntu24-puppet8-Master acpipowerbutton*)",
      "Bash(rm -rf *)"
    ]
  }
}
